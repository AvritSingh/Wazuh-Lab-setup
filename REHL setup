Make sure there are two Network adapter in your VM 

cat /etc/redhat-release
sudo rpm --import https://packages.wazuh.com/key/GPG-KEY-WAZUH

sudo tee /etc/yum.repos.d/wazuh.repo > /dev/null <<'EOF'
[wazuh]
gpgcheck=1
gpgkey=https://packages.wazuh.com/key/GPG-KEY-WAZUH
enabled=1
name=EL-$releasever - Wazuh
baseurl=https://packages.wazuh.com/4.x/yum/
priority=1
EOF

sudo dnf repolist
WAZUH SHOULD BE VISIBLE

sudo WAZUH_MANAGER="192.168.95.134" WAZUH_AGENT_NAME="RHEL-0001" dnf install wazuh-agent
                                   OR
sudo dnf --disablerepo='rhel-10-for-x86_64-*' install wazuh-agent -> Y
(If repo is acting up)
